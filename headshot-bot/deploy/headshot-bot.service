[Unit]
Description=Деловой Портрет — Telegram bot + worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/headshot-bot
EnvironmentFile=/opt/headshot-bot/.env
ExecStart=/opt/headshot-bot/venv/bin/python -m bot.main
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
